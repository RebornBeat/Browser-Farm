                  />
                </div>
                <div>
                  <label className="block text-sm text-dark-300 mb-2">
                    Locale
                  </label>
                  <input
                    type="text"
                    className="input w-full"
                    placeholder="en-US"
                    value={newProfile.locale}
                    onChange={(e) =>
                      setNewProfile({ ...newProfile, locale: e.target.value })
                    }
                  />
                </div>
              </div>

              <div>
                <label className="block text-sm text-dark-300 mb-2">
                  User Agent (optional)
                </label>
                <input
                  type="text"
                  className="input w-full"
