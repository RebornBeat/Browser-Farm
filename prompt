              </div>

              <div>
                <label className="block text-sm text-dark-300 mb-2">
                  Password
                </label>
                <input
                  type="password"
                  className="input w-full"
                  placeholder="••••••••"
                  value={newAccount.password}
                  onChange={(e) =>
                    setNewAccount({ ...newAccount, password: e.target.value })
                  }
                />
              </div>

              <div>
                <label className="block text-sm text-dark-300 mb-2">
                  Email (optional)
                </label>
